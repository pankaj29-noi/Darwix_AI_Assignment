# Copy to .env and fill only the providers you actually have.
# Empty values keep the system in labeled mock/local mode.

LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_PROVIDER=mock

ASR_API_KEY=
ASR_PROVIDER=mock

TTS_API_KEY=
TTS_PROVIDER=mock

VOICE_API_KEY=
VOICE_PROVIDER=mock

DATABASE_URL=sqlite:///./data/app.db
VECTOR_DB_PATH=./data/vector

EMBEDDING_PROVIDER=tfidf
CHUNK_SIZE=180
CHUNK_OVERLAP=40
TOP_K=4
CONFIDENCE_THRESHOLD=0.12
NUDGE_CONFIDENCE_THRESHOLD=0.62
NUDGE_COOLDOWN_SECONDS=45
AUTO_INGEST=true
